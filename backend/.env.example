# --- Core ---
NODE_ENV=development
PORT=3000
# Dev: SQLite file. Production (Supabase): postgresql://...?pgbouncer=true
DATABASE_URL=file:./dev.db

# --- Auth (JWT) ---
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_ISSUER=order-notebook
JWT_AUDIENCE=order-notebook-api
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# --- CORS (comma-separated staff app origins) ---
CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# --- AI assistant ---
# Kept for compatibility with existing encrypted AI audit data.
AI_ENCRYPTION_KEY=change-me-32-byte-key-for-aes-256!!

# DeepSeek is configured by the application operator. Never expose this key to shop users.
AI_DEFAULT_PROVIDER=DEEPSEEK
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
