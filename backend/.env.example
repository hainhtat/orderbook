# --- Core ---
NODE_ENV=development
PORT=3000
DATABASE_URL=file:./dev.db

# --- Auth (JWT) ---
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_ISSUER=order-notebook
JWT_AUDIENCE=order-notebook-api
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# --- CORS (comma-separated staff app origins) ---
CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# --- AI assistant (BYOK encryption at rest) ---
# Required: 32+ character secret used to encrypt per-shop API keys in the database.
AI_ENCRYPTION_KEY=change-me-32-byte-key-for-aes-256!!

# --- DeepSeek (local dev / optional platform default) ---
# Production uses per-shop BYOK via Settings UI; keys are stored encrypted in the DB.
# These vars let the backend call DeepSeek during development before shop BYOK is configured.
AI_DEFAULT_PROVIDER=DEEPSEEK
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
