# Order Notebook — production deployment
# Copy to deploy/.env.deploy and fill in values. Never commit deploy/.env.deploy.

# VPS SSH (password auth; rotate after first deploy)
VPS_HOST=207.148.121.162
VPS_USER=root
VPS_PASSWORD=

# Isolated install path (does not touch other sites)
VPS_APP_DIR=/opt/order-notebook

# Backend listens here; nginx proxies /api/v1 only for this vhost
VPS_API_PORT=3010

# Public URL (use IP until DNS is ready)
PUBLIC_ORIGIN=http://207.148.121.162:3011
# After DNS: PUBLIC_ORIGIN=https://pos.mmds.site

# Supabase PostgreSQL (Settings → Database → Connection string → URI, use pooler port 6543)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true

# Auth & AI (generate strong random strings)
JWT_SECRET=
AI_ENCRYPTION_KEY=

# Optional DeepSeek platform default (shop BYOK also supported)
DEEPSEEK_API_KEY=
